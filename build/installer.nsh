; Lareon setup wizard text. The pictures are installerSidebar.bmp and installerHeader.bmp.
!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Lareon"
  !define MUI_WELCOMEPAGE_TEXT "Dusk, Fledge and Aster, together in one app.$\r$\n$\r$\nYour calendar, your email and your assistant live in tabs, and you sign in once with your Lareon account.$\r$\n$\r$\nThis takes under a minute. Click Next to choose where to put it."
  !define MUI_FINISHPAGE_TITLE "Lareon is ready"
  !define MUI_FINISHPAGE_TEXT "Lareon is installed.$\r$\n$\r$\nUse Ctrl+1, Ctrl+2 and Ctrl+3 to jump between Dusk, Fledge and Aster.$\r$\n$\r$\nQuestions? Write to help@lareon.org."
  !define MUI_FINISHPAGE_LINK "Visit lareon.org"
  !define MUI_FINISHPAGE_LINK_LOCATION "https://lareon.org"
!macroend
