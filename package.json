{
  "name": "lareon-desktop",
  "version": "1.0.0",
  "description": "Lareon for desktop: Dusk, Fledge and Aster in one app",
  "main": "src/main.js",
  "author": "Lareon <help@lareon.org>",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.lareon.desktop",
    "productName": "Lareon",
    "executableName": "lareon",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/art/*.svg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Lareon-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lareon",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Lareon.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Lareon.${ext}"
    },
    "dmg": {
      "title": "Lareon",
      "backgroundColor": "#141119"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lareon-admin-off",
        "repo": "lareon-desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
